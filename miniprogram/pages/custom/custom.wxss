.container { padding: 24rpx; }

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 47, 42, 0.05);
}
.label { font-size: 26rpx; font-weight: 600; color: #3B2F2A; margin-bottom: 16rpx; }
.name-input {
  font-size: 32rpx;
  color: #3B2F2A;
  padding: 20rpx 24rpx;
  background: #F8F3EE;
  border-radius: 16rpx;
}
.ph { color: #C0B3A8; }
.counter { text-align: right; font-size: 22rpx; color: #B09A8B; margin-top: 12rpx; }

.time-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #F8F3EE;
  border-radius: 16rpx;
}
.time-val { font-size: 42rpx; font-weight: 600; color: #EE7B54; }
.time-caret { font-size: 28rpx; color: #B09A8B; }

.imgs { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.img-wrap { position: relative; width: 130rpx; height: 130rpx; }
.img-wrap image { width: 100%; height: 100%; border-radius: 16rpx; }
.img-del {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}
.upload {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #D8C7BA;
  color: #B09A8B;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.4;
  background: #FBF8F4;
}
.note-input {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #3B2F2A;
  padding: 20rpx 24rpx;
  background: #F8F3EE;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.save-btn {
  margin-top: 16rpx;
  text-align: center;
  background: #EE7B54;
  color: #ffffff;
  border-radius: 44rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(238, 123, 84, 0.28);
}
