.container { padding: 24rpx; }
.empty { text-align: center; padding: 140rpx 0; }
.empty-title { font-size: 36rpx; font-weight: 600; color: #3B2F2A; margin-bottom: 12rpx; }

.timeline { display: flex; flex-direction: column; gap: 20rpx; }
.item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 47, 42, 0.04);
}
.item-time { font-size: 22rpx; color: #B09A8B; margin-bottom: 10rpx; }
.item-title { font-size: 30rpx; font-weight: 600; color: #3B2F2A; }
.item-note { font-size: 26rpx; color: #7A6659; margin-top: 10rpx; }
.item-imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.item-img { width: 160rpx; height: 160rpx; border-radius: 16rpx; }
