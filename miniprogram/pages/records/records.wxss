.container { padding: 24rpx; }
.empty { text-align: center; padding: 120rpx 0; }
.empty-title { font-size: 34rpx; margin-bottom: 12rpx; }

.timeline { display: flex; flex-direction: column; gap: 20rpx; }
.item { background: #ffffff; border-radius: 16rpx; padding: 20rpx 24rpx; }
.item-time { font-size: 22rpx; color: #999999; margin-bottom: 8rpx; }
.item-title { font-size: 30rpx; font-weight: 500; }
.item-note { font-size: 26rpx; color: #666666; margin-top: 8rpx; }
.item-imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.item-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
