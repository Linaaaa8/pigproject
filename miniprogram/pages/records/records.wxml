<view class="container">
  <!-- 月份切换 -->
  <view class="month-bar">
    <view class="arrow" bindtap="prevMonth">‹</view>
    <view class="month-label">{{monthLabel}}</view>
    <view class="arrow" bindtap="nextMonth">›</view>
  </view>

  <!-- 连续打卡 -->
  <view class="streak">🔥 连续打卡 {{consecutive}} 天</view>

  <!-- 星期行 -->
  <view class="week-row">
    <view wx:for="{{weekdays}}" wx:key="*this" class="week-cell">{{item}}</view>
  </view>

  <!-- 日历网格 -->
  <view class="cal-grid">
    <view wx:for="{{cells}}" wx:key="id" class="day-cell">
      <block wx:if="{{!item.empty}}">
        <view class="day-num {{item.isToday ? 'today' : ''}} {{item.date === selectedDate ? 'selected' : ''}}"
              bindtap="selectDate" data-date="{{item.date}}">{{item.day}}</view>
        <view wx:if="{{item.hasRecord}}" class="dot"></view>
      </block>
    </view>
  </view>

  <!-- 当天记录 -->
  <view class="day-records">
    <view class="day-title">{{selectedDate}} · 记咗 {{dayRecords.length}} 条</view>
    <view wx:if="{{dayRecords.length === 0}}" class="empty-tip">呢日冇记录</view>
    <view wx:for="{{dayRecords}}" wx:key="_id" class="record-item">
      <view class="record-title">{{item.nodeName}} · {{item.option}}</view>
      <view class="record-time" wx:if="{{item.time}}">{{item.time}}</view>
      <view class="record-note" wx:if="{{item.note}}">{{item.note}}</view>
      <view wx:if="{{item.images && item.images.length}}" class="record-imgs">
        <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" class="record-img" />
      </view>
    </view>
  </view>
</view>
