<view class="container">
  <!-- 成长卡（紧凑单行） -->
  <view class="hero">
    <view class="hero-pig">🐷</view>
    <view class="hero-main">
      <view class="hero-title">
        <text class="hero-rank">{{pigTitle}}</text>
        <text class="hero-lv">Lv.{{pigLevel}}</text>
      </view>
      <view class="hero-sub">今日喂咗自己</view>
    </view>
    <view class="hero-stats">
      <view class="hero-stat">
        <view class="hero-num">{{todayCount}}</view>
        <view class="hero-label">今日</view>
      </view>
      <view class="hero-stat">
        <view class="hero-num">{{consecutive}}</view>
        <view class="hero-label">连续</view>
      </view>
      <view class="hero-stat">
        <view class="hero-num">{{totalCount}}</view>
        <view class="hero-label">累计</view>
      </view>
    </view>
  </view>

  <!-- 日期栏（单行） -->
  <view class="datebar">
    <view class="arrow" bindtap="prevDay">‹</view>
    <view class="datetext">{{dateLabel}}</view>
    <view class="arrow" bindtap="nextDay">›</view>
  </view>

  <!-- 分类节点网格 -->
  <view wx:for="{{groups}}" wx:key="group" class="group">
    <view class="group-title">
      <text class="group-dot" style="background:{{item.color}};"></text>
      {{item.group}}
    </view>
    <view class="grid">
      <view wx:for="{{item.nodes}}" wx:for-item="node" wx:key="id"
            class="cell {{recorded[node.id] ? 'done' : ''}}"
            style="{{recorded[node.id] ? 'background:' + item.light + ';' : ''}}"
            bindtap="togglePanel" data-id="{{node.id}}">
        <view class="cell-emoji">{{node.emoji}}</view>
        <view class="cell-name">{{node.name}}</view>
        <view class="cell-state" wx:if="{{recorded[node.id]}}" style="color:{{item.color}};">
          {{recorded[node.id].option}}{{recorded[node.id].time ? ' ' + recorded[node.id].time : ''}}
        </view>
      </view>
    </view>

    <view wx:if="{{activeNode && activeNode.group === item.group}}" class="panel">
      <view wx:if="{{activeNode.type === 'status' || activeNode.type === 'count'}}" class="opts">
        <view wx:for="{{activeNode.options}}" wx:for-item="opt" wx:key="*this"
              class="opt {{selOption === opt ? 'sel' : ''}}"
              bindtap="onOptionTap" data-opt="{{opt}}">{{opt}}</view>
      </view>

      <view wx:if="{{activeNode.type === 'status' || activeNode.type === 'count'}}" class="frow">
        <picker mode="time" value="{{selTime}}" bindchange="onTimeChange">
          <view class="field">时间 {{selTime}} ▾</view>
        </picker>
        <input wx:if="{{activeNode.type === 'count'}}" class="field input"
               placeholder="{{activeNode.notePlaceholder}}" value="{{selNote}}" bindinput="onNoteInput" />
      </view>

      <view wx:if="{{activeNode.type === 'photo'}}" class="photo-panel">
        <view class="imgs">
          <view wx:for="{{selImages}}" wx:key="*this" class="img-wrap">
            <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-idx="{{index}}" />
          </view>
          <view class="upload" bindtap="chooseImage">＋<br />上传</view>
        </view>
        <input class="field input" placeholder="{{activeNode.notePlaceholder}}" value="{{selNote}}" bindinput="onNoteInput" />
      </view>

      <view wx:if="{{activeNode.type === 'period'}}" class="period-panel">
        <picker mode="date" value="{{periodStart}}" bindchange="onPeriodStart">
          <view class="field">开始日 {{periodStart}} ▾</view>
        </picker>
        <picker mode="date" value="{{periodEnd}}" bindchange="onPeriodEnd">
          <view class="field">结束日 {{periodEnd || '未结束'}} ▾</view>
        </picker>
      </view>

      <view wx:if="{{activeNode.type === 'event'}}" class="event-panel">
        <input class="field input" placeholder="{{activeNode.contentPlaceholder}}" value="{{ddlContent}}" bindinput="onDdlContent" />
        <picker mode="date" value="{{ddlDue}}" bindchange="onDdlDue">
          <view class="field">截止 {{ddlDue || '选择日期'}} ▾</view>
        </picker>
        <view class="frow">
          <switch checked="{{ddlRemind}}" bindchange="onDdlRemind" color="#EE7B54" />
          <text class="muted">到点提醒（订阅消息）</text>
        </view>
      </view>

      <view class="save-btn" bindtap="save">保存</view>
    </view>
  </view>
</view>
