.container { padding: 24rpx 24rpx 40rpx; }

/* 成长卡（紧凑单行） */
.hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 47, 42, 0.05);
}
.hero-pig { font-size: 80rpx; line-height: 1; }
.hero-main { flex: 1; min-width: 0; }
.hero-title { display: flex; align-items: center; gap: 12rpx; }
.hero-rank { font-size: 34rpx; font-weight: 600; color: #3B2F2A; }
.hero-lv {
  font-size: 20rpx;
  color: #EE7B54;
  background: #FCE9E0;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.hero-sub { font-size: 20rpx; color: #A08C82; margin-top: 6rpx; }
.hero-stats { display: flex; gap: 26rpx; }
.hero-num { font-size: 34rpx; font-weight: 600; color: #3B2F2A; line-height: 1.1; text-align: center; }
.hero-label { font-size: 20rpx; color: #A08C82; margin-top: 4rpx; text-align: center; }

/* 日期栏（单行） */
.datebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 47, 42, 0.05);
}
.arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F6EEE6;
  color: #EE7B54;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.datetext { font-size: 30rpx; font-weight: 600; color: #3B2F2A; }

/* 分组（轻量标题） */
.group { margin-bottom: 24rpx; }
.group-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #8A7A70;
  margin: 0 6rpx 12rpx;
}
.group-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }

/* 网格卡片（4 列，矮化） */
.grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cell {
  width: calc((100% - 36rpx) / 4);
  background: #ffffff;
  border-radius: 18rpx;
  padding: 18rpx 6rpx 14rpx;
  text-align: center;
  box-shadow: 0 4rpx 14rpx rgba(59, 47, 42, 0.04);
  box-sizing: border-box;
}
.cell-emoji { font-size: 40rpx; line-height: 1.15; }
.cell-name { font-size: 22rpx; font-weight: 500; color: #3B2F2A; margin-top: 6rpx; }
.cell-state { font-size: 18rpx; color: #B8A79D; margin-top: 4rpx; }

/* 展开面板 */
.panel {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 47, 42, 0.06);
}
.opts { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.opt {
  background: #F6EEE6;
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #5A4A43;
}
.opt.sel {
  background: #EE7B54;
  color: #ffffff;
  font-weight: 600;
}

.frow { display: flex; gap: 16rpx; align-items: center; }
.field {
  background: #F8F3EE;
  border: 2rpx solid #EFE4DA;
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  color: #3B2F2A;
}
.field.input { flex: 1; min-width: 0; }

/* 穿搭上传 */
.photo-panel .imgs { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.img-wrap { width: 130rpx; height: 130rpx; border-radius: 16rpx; overflow: hidden; }
.img-wrap image { width: 100%; height: 100%; }
.upload {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #D8C7BA;
  color: #B09A8B;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.4;
  background: #FBF8F4;
}

.period-panel, .event-panel { display: flex; flex-direction: column; gap: 16rpx; }

.save-btn {
  margin-top: 24rpx;
  text-align: center;
  background: #EE7B54;
  color: #ffffff;
  border-radius: 44rpx;
  padding: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(238, 123, 84, 0.28);
}
