.container { padding: 24rpx; }
.stats { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.stat {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(59, 47, 42, 0.04);
}
.stat-num { font-size: 52rpx; font-weight: 600; color: #EE7B54; }
.stat-label { font-size: 24rpx; color: #A08C82; margin-top: 8rpx; }

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 47, 42, 0.04);
}
.card-title { font-size: 30rpx; font-weight: 600; color: #3B2F2A; margin-bottom: 16rpx; }
.ddl-item { padding: 14rpx 0; border-bottom: 1rpx solid #F1E8E0; color: #3B2F2A; }
.ddl-item:last-child { border-bottom: none; }
