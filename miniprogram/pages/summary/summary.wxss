.container { padding: 24rpx 24rpx 40rpx; }

/* 三个数字卡 */
.stat-cards { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 26rpx 12rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(59, 47, 42, 0.05);
}
.stat-num { font-size: 44rpx; font-weight: 600; color: #EE7B54; line-height: 1.1; }
.stat-label { font-size: 20rpx; color: #A08C82; margin-top: 8rpx; }

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 47, 42, 0.05);
}
.card-title { font-size: 28rpx; font-weight: 600; color: #3B2F2A; margin-bottom: 16rpx; }
.card-text { font-size: 26rpx; color: #5A4A43; }
.card-text.muted { color: #A08C82; margin-top: 6rpx; }

/* 分类行 */
.cat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F8F3EE;
}
.cat-row:last-child { border-bottom: none; }
.cat-name { font-size: 28rpx; color: #3B2F2A; }
.cat-count { font-size: 28rpx; color: #EE7B54; font-weight: 600; }

/* DDL 行 */
.ddl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F8F3EE;
}
.ddl-row:last-child { border-bottom: none; }
.ddl-name { font-size: 26rpx; color: #3B2F2A; }
.ddl-due { font-size: 24rpx; color: #E8708A; }

.empty-tip { text-align: center; font-size: 24rpx; color: #C0B3A8; padding: 20rpx 0; }
