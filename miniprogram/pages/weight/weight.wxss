.container { padding: 24rpx; }

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 47, 42, 0.05);
}
.label { font-size: 26rpx; font-weight: 600; color: #3B2F2A; margin-bottom: 16rpx; }

.weight-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F8F3EE;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.weight-input { flex: 1; font-size: 48rpx; font-weight: 600; color: #EE7B54; min-width: 0; }
.unit { font-size: 32rpx; color: #A08C82; }
.ph { color: #C0B3A8; }

.time-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #F8F3EE;
  border-radius: 16rpx;
}
.time-val { font-size: 42rpx; font-weight: 600; color: #EE7B54; }
.time-caret { font-size: 28rpx; color: #B09A8B; }

.save-btn {
  margin-top: 16rpx;
  text-align: center;
  background: #EE7B54;
  color: #ffffff;
  border-radius: 44rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(238, 123, 84, 0.28);
}
