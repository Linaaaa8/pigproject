.container { padding: 24rpx; }

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 47, 42, 0.05);
}
.label { font-size: 26rpx; font-weight: 600; color: #3B2F2A; margin-bottom: 16rpx; }

.time-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #F8F3EE;
  border-radius: 16rpx;
}
.time-val { font-size: 42rpx; font-weight: 600; color: #EE7B54; }
.time-caret { font-size: 28rpx; color: #B09A8B; }

.part-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1E8E0;
}
.part-row:last-child { border-bottom: none; }
.part-name { font-size: 28rpx; color: #3B2F2A; display: flex; align-items: center; gap: 10rpx; }
.part-emoji { font-size: 32rpx; }
.part-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F8F3EE;
  border-radius: 14rpx;
  padding: 10rpx 20rpx;
}
.part-input { width: 140rpx; font-size: 30rpx; font-weight: 600; color: #EE7B54; text-align: right; }
.part-unit { font-size: 24rpx; color: #A08C82; }
.ph { color: #C0B3A8; }

.save-btn {
  margin-top: 16rpx;
  text-align: center;
  background: #EE7B54;
  color: #ffffff;
  border-radius: 44rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(238, 123, 84, 0.28);
}
